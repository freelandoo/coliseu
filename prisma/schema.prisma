generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECEPCAO
  TECNICO
}

enum Origem {
  whatsapp
  redes
  balcao
  indicacao
}

enum PessoaFase {
  lead
  aluno
  /// Ex-aluno importado do histórico do CloudGym. Fica fora das telas do dia a
  /// dia (que carregam só lead/aluno); aparece no Analytics. Volta a ser lead se
  /// mandar mensagem no WhatsApp.
  exaluno
}

enum LeadEstagio {
  novo
  qualificado
  interesse
  perdido
  convertido
}

enum MembershipStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  SUSPENDED
  CANCELED
  EXPIRED
}

enum CobrancaStatus {
  pendente
  pago
  atrasado
  cancelado
  estornado
}

enum CobrancaTipo {
  matricula
  mensalidade
  renovacao
  avulsa
}

model Unit {
  id               String   @id @default(cuid())
  slug             String   @unique
  nome             String
  /// Dados cadastrais vindos do CloudGym (unidade 1668).
  legacyCloudgymId Int?     @unique
  razaoSocial      String?
  cnpj             String?
  endereco         String?
  bairro           String?
  cidade           String?
  uf               String?
  cep              String?
  telefone         String?
  timezone         String?
  createdAt        DateTime @default(now())
  users            User[]
  people           Person[]
  plans            Plan[]

  devices  AccessDevice[]
  policies AccessPolicy[]

  whatsappInstances  WhatsappInstance[]
  conversas          Conversa[]
  aulasExperimentais AulaExperimental[]

  contasContabeis ContaContabil[]
  contasBancarias ContaBancaria[]
  colaboradores   Colaborador[]
  aulasGrade      AulaGrade[]
}

model User {
  id              String     @id @default(cuid())
  /// Nome de acesso. O admin cria colaborador sem exigir e-mail.
  login           String     @unique
  email           String?    @unique
  nome            String
  passwordHash    String
  role            Role       @default(RECEPCAO)
  /// Desativar em vez de apagar: preserva a trilha de quem fez o quê.
  ativo           Boolean    @default(true)
  /// Senha definida pelo admin — força a troca no primeiro acesso.
  senhaProvisoria Boolean    @default(false)
  /// Conta de manutenção do sistema. Não é um papel: é um recorte à parte, e o
  /// único que abre a lixeira de conversas (/backup). Nem ADMIN entra lá.
  desenvolvedor   Boolean    @default(false)
  /// Teclado de quem atende: Enter envia a resposta do WhatsApp, ou quebra
  /// linha. Fica na conta e não no navegador porque o balcão é compartilhado —
  /// a preferência tem de viajar com quem loga, não com a máquina. Padrão
  /// `false`: quebrar linha é o comportamento antigo, e o erro dele (mensagem
  /// parada na caixa) custa menos que o do outro lado (meia resposta no
  /// celular do cliente).
  enterEnvia      Boolean    @default(false)
  unit            Unit       @relation(fields: [unitId], references: [id])
  unitId          String
  createdAt       DateTime   @default(now())
  sessions        Session[]
  apiTokens       ApiToken[]

  /// Colaborador que também é cadastro da academia (aluno virou recepcionista).
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  personId String? @unique

  conversasAtendidas Conversa[]
  mensagensEnviadas  Mensagem[]
  atendimentos       AtendimentoRegistro[]
  matriculasFeitas   Membership[]          @relation("MatriculadoPor")
  pushSubscriptions  PushSubscription[]
  notificacoes       Notificacao[]
  respostasProntas   RespostaPronta[]
  aulasAgendadas     AulaExperimental[]
  presencas          PresencaSlot[]
}

/// Ponto batido pelo navegador de quem está logado: um bloco de cinco minutos
/// em que o sistema esteve aberto **e** havia alguém na frente dele — a batida
/// só sai com a aba visível e mão no aparelho há menos de cinco minutos (ver
/// `PresencaHeartbeat` e `@/lib/uso`).
///
/// É uma linha por bloco, e não um "último visto" no usuário, porque a pergunta
/// da tela é quanto tempo somado, não quando foi a última vez: com um campo só,
/// "trabalhou seis horas" seria impossível de responder. O par único (usuário,
/// bloco) faz a batida repetida cair fora sozinha, sem leitura antes da escrita.
model PresencaSlot {
  id     String   @id @default(cuid())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  /// Início do bloco de cinco minutos, em UTC.
  slot   DateTime

  @@unique([userId, slot])
  @@index([slot])
}

/// Inscrição de Web Push do PWA: cada linha é um navegador/aparelho que aceitou
/// receber aviso de mensagem nova no atendimento. O endpoint identifica o
/// aparelho; reassinar noutra conta só muda o dono.
model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Aviso para quem administra (sininho + push). Uma linha por destinatário,
/// para cada um ter o próprio "lido". `chave` identifica o fato que gerou o
/// aviso: o webhook reentregue não avisa duas vezes.
model Notificacao {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// pagamento_recebido | pagamento_vencido | pagamento_estornado | pagamento_chargeback
  tipo      String
  titulo    String
  corpo     String
  url       String?
  chave     String
  lidaEm    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, chave])
  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Person {
  id               String       @id @default(cuid())
  codigo           String       @unique
  nome             String
  telefone         String?
  email            String?
  cpf              String?
  rg               String?
  vendedor         String? // consultor que fez a venda (herdado do CloudGym)
  origem           Origem
  fase             PessoaFase   @default(lead)
  estagio          LeadEstagio?
  motivoPerdido    String?
  dataNascimento   String?
  cep              String?
  estado           String?
  cidade           String?
  rua              String?
  numero           String?
  /// Migração CloudGym: ids legados (upsert idempotente) e campos sem lugar antes.
  legacyCloudgymId Int?         @unique
  legacyLeadId     Int?         @unique
  legacyName       String?
  genero           String?
  telefoneFixo     String?
  origemLegado     String?
  cadastroLegado   DateTime?    @db.Date
  inativadoEm      DateTime?    @db.Date
  criadoEm         DateTime     @default(now())

  unit   Unit   @relation(fields: [unitId], references: [id])
  unitId String

  memberships     Membership[]
  cobrancas       Cobranca[]
  billingCustomer BillingCustomer?
  payments        Payment[]

  credentials    AccessCredential[]
  deviceMappings DeviceUserMapping[]
  accessEvents   AccessEvent[]
  enrollments    EnrollmentSession[]
  overrides      ManualAccessOverride[]

  conversas Conversa[]
  usuario   User?

  aulasExperimentais AulaExperimental[]

  historicoPlanos HistoricoPlano[]
  parcelas        Parcela[]
  checkIns        CheckIn[]
  npsRespostas    NpsResposta[]

  @@index([unitId, fase])
  @@index([nome])
}

model Plan {
  id          String  @id @default(cuid())
  nome        String
  valorMensal Float
  /// Vigência do contrato em dias — o balcão pensa em dias (30, 90, 365),
  /// e o vencimento sai de soma de dias, sem a ambiguidade de "mês".
  duracaoDias Int
  ativo       Boolean @default(true)
  descricao   String?

  /// Migração CloudGym: valorMensal = price × months ÷ duration; `meses` = duration; adesão em `taxaAdesao`
  /// dividida em `parcelasAdesao`.
  legacyCloudgymId Int?           @unique
  meses            Int?
  taxaAdesao       Decimal?       @db.Decimal(12, 2)
  parcelasAdesao   Int?
  contaContabil    ContaContabil? @relation(fields: [contaContabilId], references: [id], onDelete: SetNull)
  contaContabilId  String?

  unit   Unit   @relation(fields: [unitId], references: [id])
  unitId String

  memberships Membership[]
  historicos  HistoricoPlano[]

  accessPolicies AccessPolicy[]

  /// Plano mesclado em outro (tela Planos → Mesclar): fica arquivado como
  /// registro, os alunos foram para o destino. O importador do CloudGym
  /// respeita — não reativa nem devolve alunos para um plano mesclado.
  mescladoEm   Plan?   @relation("PlanoMesclado", fields: [mescladoEmId], references: [id], onDelete: SetNull)
  mescladoEmId String?
  mesclados    Plan[]  @relation("PlanoMesclado")

  @@index([unitId, ativo])
}

model Membership {
  id                  String           @id @default(cuid())
  person              Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId            String
  plan                Plan             @relation(fields: [planId], references: [id])
  planId              String
  status              MembershipStatus @default(DRAFT)
  matriculadoEm       DateTime         @default(now())
  vencimentoPlano     DateTime
  ultimaPresenca      DateTime         @default(now())
  courtesyEntriesLeft Int              @default(1)

  /// Quem fez a matrícula. SetNull para o colaborador poder sair sem apagar
  /// a matrícula — perde-se o nome, nunca o registro do aluno.
  matriculadoPor   User?   @relation("MatriculadoPor", fields: [matriculadoPorId], references: [id], onDelete: SetNull)
  matriculadoPorId String?

  @@index([personId, status])
  @@index([matriculadoPorId])
}

model Cobranca {
  id            String         @id @default(cuid())
  person        Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId      String
  tipo          CobrancaTipo
  valor         Float
  vencimento    DateTime
  status        CobrancaStatus @default(pendente)
  asaasId       String?
  assinaturaId  String?
  linkPagamento String?
  metodo        String? // venda de balcão: dinheiro | pix | debito | credito
  updatedAt     DateTime       @default(now()) @updatedAt

  @@index([personId, status])
  @@index([asaasId])
  @@index([updatedAt])
}

model Despesa {
  id         String   @id @default(cuid())
  categoria  String
  descricao  String?
  valor      Float
  data       DateTime
  recorrente Boolean  @default(false)
}

enum WebhookProcessState {
  PENDING
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  REFUNDED
  CHARGEBACK
  CANCELED
}

model WebhookEvent {
  id           String              @id @default(cuid())
  asaasEventId String              @unique
  event        String
  paymentId    String?
  payload      Json
  processState WebhookProcessState @default(PENDING)
  attempts     Int                 @default(0)
  lastError    String?
  eventAt      DateTime?
  receivedAt   DateTime            @default(now())
  processedAt  DateTime?

  @@index([processState, receivedAt])
  @@index([paymentId])
}

model BillingCustomer {
  id                String   @id @default(cuid())
  asaasCustomerId   String   @unique
  externalReference String?
  person            Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId          String   @unique
  createdAt         DateTime @default(now())

  subscriptions BillingSubscription[]
}

model BillingSubscription {
  id                  String          @id @default(cuid())
  asaasSubscriptionId String          @unique
  externalReference   String?
  customer            BillingCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId          String
  cycle               String          @default("MONTHLY")
  value               Float
  status              String          @default("ACTIVE")
  createdAt           DateTime        @default(now())

  payments Payment[]

  @@index([customerId])
}

model Payment {
  id                String               @id @default(cuid())
  asaasPaymentId    String               @unique
  externalReference String?
  subscription      BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionId    String?
  /// Forma escolhida pelo aluno no link (PIX | BOLETO | CREDIT_CARD). UNDEFINED
  /// até ele pagar: a cobrança nasce aberta para qualquer forma.
  billingType       String               @default("UNDEFINED")
  /// Dono da cobrança. Mensalidade também chega pela assinatura; avulsa só por aqui.
  person            Person?              @relation(fields: [personId], references: [id], onDelete: SetNull)
  personId          String?
  descricao         String?
  value             Float
  dueDate           DateTime
  status            PaymentStatus        @default(PENDING)
  paidAt            DateTime?
  invoiceUrl        String?
  statusUpdatedAt   DateTime             @default(now())
  createdAt         DateTime             @default(now())

  @@index([subscriptionId, dueDate])
  @@index([status])
  @@index([personId, dueDate])
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  ENROLLED
  FAILED
  REVOKED
}

enum DeviceSyncStatus {
  IN_SYNC
  PENDING
  ERROR
}

enum DeviceCommandStatus {
  PENDING
  DISPATCHED
  ACKNOWLEDGED
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum CredentialType {
  FACE
  CARD
  PIN
}

enum AccessDeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum OverrideAction {
  ALLOW
  BLOCK
}

model AccessDevice {
  id              String             @id @default(cuid())
  unit            Unit               @relation(fields: [unitId], references: [id])
  unitId          String
  name            String
  lanHost         String?
  lanPort         Int?
  firmware        String?
  mode            String             @default("HYBRID")
  status          AccessDeviceStatus @default(OFFLINE)
  lastHeartbeatAt DateTime?
  agentId         String?
  createdAt       DateTime           @default(now())

  mappings   DeviceUserMapping[]
  commands   DeviceCommand[]
  heartbeats DeviceHeartbeat[]
  events     AccessEvent[]

  @@unique([unitId, name])
  @@index([unitId, status])
}

model AccessCredential {
  id         String           @id @default(cuid())
  person     Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId   String
  type       CredentialType
  status     EnrollmentStatus @default(NOT_STARTED)
  deviceRef  String? // id no dispositivo (NUNCA template bruto)
  enrolledAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime         @default(now())

  @@index([personId, type])
}

model DeviceUserMapping {
  id             String           @id @default(cuid())
  device         AccessDevice     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId       String
  person         Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId       String
  externalUserId String
  syncStatus     DeviceSyncStatus @default(PENDING)
  lastSyncAt     DateTime?

  @@unique([deviceId, externalUserId])
  @@unique([deviceId, personId])
  @@index([syncStatus])
}

model AccessPolicy {
  id               String   @id @default(cuid())
  unit             Unit     @relation(fields: [unitId], references: [id])
  unitId           String
  plan             Plan?    @relation(fields: [planId], references: [id])
  planId           String?
  graceDays        Int      @default(5)
  maxEntriesPerDay Int?
  timeZones        Json? // janelas de horário (livre)
  createdAt        DateTime @default(now())

  @@index([unitId, planId])
}

model AccessEvent {
  id               String       @id @default(cuid())
  device           AccessDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId         String
  person           Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  personId         String?
  unitId           String
  deviceEventId    String?
  deviceTime       DateTime
  serverTime       DateTime     @default(now())
  direction        String       @default("ENTRY")
  credentialType   String?
  decision         String // ALLOWED | DENIED
  reason           String?
  physicallyPassed Boolean      @default(false)
  mode             String       @default("ONLINE")
  deviceCursor     String?

  @@unique([deviceId, deviceEventId])
  @@index([personId, deviceTime])
  @@index([unitId, serverTime])
}

model DeviceCommand {
  id           String              @id @default(cuid())
  device       AccessDevice        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId     String
  personId     String?
  type         String // UPSERT_USER | ENABLE | DISABLE | REMOVE_USER | ENROLL | OPEN | SYNC_RULES | SHUTDOWN
  payload      Json?
  status       DeviceCommandStatus @default(PENDING)
  attempts     Int                 @default(0)
  dedupeKey    String              @unique
  lastError    String?
  dispatchedAt DateTime?
  ackAt        DateTime?
  createdAt    DateTime            @default(now())

  @@index([status, deviceId])
  @@index([deviceId, personId, status])
}

model DeviceHeartbeat {
  id           String       @id @default(cuid())
  device       AccessDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId     String
  at           DateTime     @default(now())
  firmware     String?
  connectivity String?
  clockDriftMs Int?

  @@index([deviceId, at])
}

model EnrollmentSession {
  id        String           @id @default(cuid())
  person    Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId  String
  deviceId  String?
  type      CredentialType   @default(FACE)
  status    EnrollmentStatus @default(IN_PROGRESS)
  startedAt DateTime         @default(now())
  resultAt  DateTime?

  @@index([status])
}

model ManualAccessOverride {
  id              String         @id @default(cuid())
  person          Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId        String
  action          OverrideAction
  reason          String
  expiresAt       DateTime?
  createdByUserId String?
  createdAt       DateTime       @default(now())

  @@index([personId, expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorType String // USER | AGENT | SYSTEM | WEBHOOK
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  at        DateTime @default(now())

  @@index([entity, entityId, at])
}

model ApiToken {
  id          String    @id @default(cuid())
  provider    String    @unique // "freelandoo"
  tokenHash   String // sha256 hex do token em claro — nunca o token
  createdAt   DateTime  @default(now())
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdById String
  lastUsedAt  DateTime?
}

// ─── Atendimento WhatsApp (Evolution API) ────────────────────────────────────
// Ver docs/superpowers/specs/2026-07-22-whatsapp-atendimento-design.md.
// Regra do subsistema: nada aqui responde sozinho. O webhook só grava; enviar
// exige clique humano na Captação.

enum WhatsappStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
}

enum ConversaInteresse {
  nao_classificado
  com_interesse
  sem_interesse
  perdido
  convertido
}

enum MensagemDirecao {
  IN
  OUT
}

enum MensagemAutor {
  LEAD
  ATENDENTE
}

model WhatsappInstance {
  id                String         @id @default(cuid())
  unit              Unit           @relation(fields: [unitId], references: [id])
  unitId            String
  evolutionInstance String         @unique // nome técnico na Evolution
  nome              String
  status            WhatsappStatus @default(DISCONNECTED)
  numeroConectado   String?
  ultimoEstadoEm    DateTime?
  criadoEm          DateTime       @default(now())

  conversas Conversa[]

  @@index([unitId, status])
}

model Conversa {
  id         String           @id @default(cuid())
  unit       Unit             @relation(fields: [unitId], references: [id])
  unitId     String
  instance   WhatsappInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId String
  remoteJid  String
  telefone   String // só dígitos; vazio quando o JID não expõe o número (@lid) ou é grupo
  pushName   String? // pessoa: nome do perfil de quem escreve; grupo: assunto do grupo
  ehGrupo    Boolean          @default(false) // JID @g.us: conversa coletiva, não vira lead

  person      Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  personId    String?
  atendente   User?   @relation(fields: [atendenteId], references: [id], onDelete: SetNull)
  atendenteId String?

  interesse             ConversaInteresse @default(nao_classificado)
  naoLidas              Int               @default(0)
  ultimaMensagemEm      DateTime          @default(now())
  ultimaMensagemPreview String            @default("")
  criadoEm              DateTime          @default(now())

  mensagens          Mensagem[]
  atendimentos       AtendimentoRegistro[]
  aulasExperimentais AulaExperimental[]

  @@unique([instanceId, remoteJid])
  @@index([unitId, ultimaMensagemEm])
  @@index([personId])
}

model Mensagem {
  id          String          @id @default(cuid())
  conversa    Conversa        @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  conversaId  String
  waMessageId String          @unique // key.id do WhatsApp — dedupe de reentrega
  direcao     MensagemDirecao
  autor       MensagemAutor
  autorUser   User?           @relation(fields: [autorUserId], references: [id], onDelete: SetNull)
  autorUserId String? // nulo em OUT enviado pelo celular do dono
  remetente   String? // quem escreveu dentro do grupo; nulo em conversa 1:1
  texto       String
  tipoMidia   String          @default("texto") // texto | imagem | audio | video | documento | outro
  enviadaEm   DateTime        @default(now())
  erro        String?

  /// Citação — a mensagem que esta responde, o "responder" do WhatsApp.
  /// Guardamos o `key.id` (é por ele que o WhatsApp liga uma na outra) e uma
  /// **cópia** do trecho e de quem escreveu: a citação tem de continuar legível
  /// mesmo depois de a original ser apagada da conversa.
  citadaWaId  String?
  citadaTexto String?
  citadaAutor String?

  @@index([conversaId, enviadaEm])
  @@index([citadaWaId])
}

/// O que motivou a cópia de segurança: "limpar" apagou só as mensagens e
/// deixou a conversa na lista; "remover" apagou a conversa inteira.
enum BackupMotivo {
  limpar
  remover
}

/// Lixeira do atendimento. Antes de apagar, "limpar" e "remover" copiam a
/// conversa e todo o histórico para cá — de propósito **sem** chave estrangeira
/// para Conversa/User/Person, senão a cópia morreria junto com o original.
/// Só o usuário desenvolvedor enxerga e restaura o que está aqui.
model ConversaBackup {
  id          String  @id @default(cuid())
  /// Id da conversa original — a restauração tenta recriá-la com o mesmo id.
  conversaId  String
  unitId      String
  instanceId  String
  remoteJid   String
  telefone    String
  pushName    String?
  ehGrupo     Boolean @default(false)
  personId    String?
  atendenteId String?

  interesse             ConversaInteresse @default(nao_classificado)
  ultimaMensagemEm      DateTime
  ultimaMensagemPreview String            @default("")
  /// Quando a conversa original nasceu (não a data do backup).
  conversaCriadaEm      DateTime

  motivo          BackupMotivo
  excluidoEm      DateTime     @default(now())
  excluidoPorId   String?
  /// Nome copiado no ato: o backup precisa dizer quem apagou mesmo depois de
  /// o colaborador sair e a conta sumir.
  excluidoPorNome String
  restauradoEm    DateTime?

  mensagens MensagemBackup[]

  @@index([excluidoEm])
  @@index([conversaId])
}

/// Mensagem copiada junto com a conversa. `waMessageId` aqui não é único: a
/// mesma mensagem pode ser apagada, restaurada e apagada de novo.
model MensagemBackup {
  id       String         @id @default(cuid())
  backup   ConversaBackup @relation(fields: [backupId], references: [id], onDelete: Cascade)
  backupId String

  /// Id da mensagem original — a restauração recria com ele quando está livre.
  mensagemId  String
  waMessageId String
  direcao     MensagemDirecao
  autor       MensagemAutor
  autorUserId String?
  remetente   String?
  texto       String
  tipoMidia   String          @default("texto")
  enviadaEm   DateTime
  erro        String?

  /// Citação copiada junto — ver `Mensagem`.
  citadaWaId  String?
  citadaTexto String?
  citadaAutor String?

  @@index([backupId, enviadaEm])
}

/// Resposta pronta do atendimento: texto cadastrado uma vez e compartilhado
/// por todos os usuários — qualquer atendente escolhe da lista e a resposta
/// cai na caixa de texto. SetNull: apagar o usuário não apaga o acervo comum.
model RespostaPronta {
  id          String   @id @default(cuid())
  /// Identificação na lista, editável sem mexer na mensagem; sem título,
  /// a lista mostra a primeira frase do texto.
  titulo      String?
  texto       String
  criadoPor   User?    @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoPorId String?
  criadoEm    DateTime @default(now())

  @@index([criadoEm])
}

/// Cadastro de atendimento: log append-only de quem classificou o quê.
model AtendimentoRegistro {
  id         String            @id @default(cuid())
  conversa   Conversa          @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  conversaId String
  user       User              @relation(fields: [userId], references: [id])
  userId     String
  interesse  ConversaInteresse
  observacao String?
  criadoEm   DateTime          @default(now())

  @@index([conversaId, criadoEm])
}

/// Aula experimental marcada pela recepção durante a conversa. É o compromisso
/// combinado, não um evento de agenda: guarda a data como "AAAA-MM-DD" e a hora
/// como inteiro, na hora do relógio da academia. Guardar `DateTime` obrigaria
/// todo mundo (servidor em UTC, celular da recepção em São Paulo) a concordar
/// sobre fuso para responder "quem tem aula hoje?" — com data em texto, a
/// pergunta é uma comparação de string e nunca vira aula no dia errado.
model AulaExperimental {
  id     String @id @default(cuid())
  unit   Unit   @relation(fields: [unitId], references: [id])
  unitId String

  /// Conversa e cadastro são vínculos frouxos de propósito: apagar a conversa
  /// (ou o lead) não apaga o compromisso já combinado com a pessoa.
  conversa   Conversa? @relation(fields: [conversaId], references: [id], onDelete: SetNull)
  conversaId String?
  person     Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  personId   String?

  /// Cópia do nome e do telefone no momento do agendamento — a lista continua
  /// legível mesmo se o cadastro sumir.
  nome     String
  telefone String

  modalidade String
  /// "AAAA-MM-DD" no relógio da academia; ordena por ordem alfabética.
  data       String
  /// Hora cheia, 6 a 22.
  hora       Int

  /// Recado da recepção sobre essa visita, escrito no calendário da Captação:
  /// o que combinaram fora do horário ("vem com a mãe", "só depois das 19h").
  /// Fica na aula e não na conversa porque quem lê é quem abre a agenda do dia.
  observacao String?

  agendadoPor   User?    @relation(fields: [agendadoPorId], references: [id], onDelete: SetNull)
  agendadoPorId String?
  criadoEm      DateTime @default(now())

  @@index([unitId, data])
  @@index([conversaId])
}

// ============================================================
// Migração CloudGym (export de 2026-10-05) + base do Analytics.
// Valores em numeric(12,2). Toda linha importada carrega a chave legada
// (`legacyCloudgymId` ou `chave` determinística) para o import ser idempotente.
// Plano: docs/superpowers/plans/2026-10-05-importacao-cloudgym-analytics.md
// ============================================================

/// Árvore do plano de contas (pai → filho), base do DRE e do fluxo de caixa.
model ContaContabil {
  id               String          @id @default(cuid())
  legacyCloudgymId Int             @unique
  nome             String
  /// true = conta de débito (saída); false = crédito (entrada).
  debito           Boolean
  ativo            Boolean
  tipo             String?
  pai              ContaContabil?  @relation("ContaPai", fields: [paiId], references: [id], onDelete: SetNull)
  paiId            String?
  filhas           ContaContabil[] @relation("ContaPai")
  unit             Unit            @relation(fields: [unitId], references: [id])
  unitId           String

  planos   Plan[]
  parcelas Parcela[]
  taxas    TaxaPagamento[]

  @@index([paiId])
}

/// Contas bancárias da academia. Dado sensível: só ADMIN.
model ContaBancaria {
  id               String  @id @default(cuid())
  legacyCloudgymId Int     @unique
  codigo           String
  nome             String
  agencia          String
  conta            String
  saldo            Decimal @db.Decimal(12, 2)
  unit             Unit    @relation(fields: [unitId], references: [id])
  unitId           String
}

/// Equipe do CloudGym (professores, recepção, gerentes). Não dá acesso ao
/// sistema: vincular a um `User` é decisão manual do admin.
model Colaborador {
  id               String      @id @default(cuid())
  legacyCloudgymId Int         @unique
  nome             String
  sobrenome        String?
  email            String?
  cargo            String?
  cadastradoEm     DateTime?   @db.Date
  unit             Unit        @relation(fields: [unitId], references: [id])
  unitId           String
  aulas            AulaGrade[]
}

/// Histórico de planos do cliente (coluna `plan`, separada por "|"). ordem 0 = mais recente.
model HistoricoPlano {
  id        String  @id @default(cuid())
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId  String
  ordem     Int
  nomePlano String
  plan      Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  planId    String?

  @@unique([personId, ordem])
}

/// Parcela financeira (paga ou a vencer) — fonte do Entrada de Receita, Fluxo de
/// Caixa e DRE. `realizadoCaixa` marca o que aparece na visão "Realizado Caixa".
model Parcela {
  id              String         @id @default(cuid())
  legacyPaymentId Int            @unique
  legacyMemberId  Int
  person          Person?        @relation(fields: [personId], references: [id], onDelete: SetNull)
  personId        String?
  unitId          String
  vencimento      DateTime       @db.Date
  pagamento       DateTime?      @db.Date
  compensacao     DateTime?      @db.Date
  valorBruto      Decimal        @db.Decimal(12, 2)
  valorLiquido    Decimal?       @db.Decimal(12, 2)
  /// Código CloudGym (CC, ECC, ECD, BT, PIXA, OC, BL, DN, CH, DC, LC, GP, TP, OT).
  forma           String
  /// Só os 4 últimos dígitos. O número completo nunca é gravado.
  cartaoFinal     String?
  bandeira        String?
  nsu             String?
  /// stone | pagarme (campo_15 do export).
  gateway         String?
  /// paid | canceled (estorno) | error | overdue | null (a vencer / legado sem status).
  status          String?
  /// mensalidade (i) | adesao (e) | legado (vazio).
  tipo            String
  contaContabil   ContaContabil? @relation(fields: [contaContabilId], references: [id], onDelete: SetNull)
  contaContabilId String?
  realizadoCaixa  Boolean        @default(false)

  @@index([personId, vencimento])
  @@index([unitId, pagamento])
  @@index([unitId, vencimento])
}

/// Taxa de adquirência por pagamento (conta "Bancos" do plano de contas).
model TaxaPagamento {
  id              String         @id @default(cuid())
  /// member|data|valor|n — o export não traz id próprio.
  chave           String         @unique
  legacyMemberId  Int
  personId        String?
  unitId          String
  data            DateTime       @db.Date
  valor           Decimal        @db.Decimal(12, 2)
  contaContabil   ContaContabil? @relation(fields: [contaContabilId], references: [id], onDelete: SetNull)
  contaContabilId String?

  @@index([unitId, data])
}

/// Vendas de contratos agregadas por dia × plano × vendedor (relatório Vendas).
model VendaPlanoDia {
  id           String   @id @default(cuid())
  chave        String   @unique
  unitId       String
  data         DateTime @db.Date
  nomePlano    String
  planId       String?
  qtdContratos Int
  total        Decimal  @db.Decimal(12, 2)
  vendedorId   Int?
  vendedorNome String?

  @@index([unitId, data])
}

/// Livro caixa (serviços + operacional). As visões Vendido e Recebido do
/// CloudGym são quase iguais: uma linha só, com as duas flags.
model LancamentoCaixa {
  id             String   @id @default(cuid())
  chave          String   @unique
  unitId         String
  /// servico | operacional
  categoria      String
  data           DateTime @db.Date
  valor          Decimal  @db.Decimal(12, 2)
  forma          String?
  legacyMemberId Int?
  personId       String?
  descricao      String
  vendedorNome   String?
  vendido        Boolean  @default(false)
  recebido       Boolean  @default(false)

  @@index([unitId, data])
}

/// Presença (check-in). origem "cloudgym" = relatório de frequência do CloudGym;
/// os giros da catraca seguem em AccessEvent. O contato bruto só fica guardado
/// enquanto a linha não tem dono, para vincular num import futuro.
model CheckIn {
  id           String   @id @default(cuid())
  chave        String   @unique
  unitId       String
  person       Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  personId     String?
  ocorridoEm   DateTime
  origem       String   @default("cloudgym")
  /// email | celular | nome — por qual chave a linha achou dono.
  vinculo      String?
  nomeBruto    String?
  emailBruto   String?
  celularBruto String?

  @@index([personId, ocorridoEm])
  @@index([unitId, ocorridoEm])
}

model NpsResposta {
  id           String   @id @default(cuid())
  chave        String   @unique
  unitId       String
  person       Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  personId     String?
  respondidaEm DateTime
  score        Int
  feedback     String?

  @@index([unitId, respondidaEm])
}

/// Grade semanal de aulas. diaSemana: 0 = domingo … 6 = sábado.
model AulaGrade {
  id               String       @id @default(cuid())
  legacyCloudgymId Int          @unique
  nome             String
  diaSemana        Int
  inicio           String
  fim              String
  capacidade       Int
  professor        Colaborador? @relation(fields: [professorId], references: [id], onDelete: SetNull)
  professorId      String?
  unit             Unit         @relation(fields: [unitId], references: [id])
  unitId           String
}

/// Auditoria do CloudGym. Separada do AuditLog novo, que tem outro formato.
model AuditoriaLegado {
  id             String   @id @default(cuid())
  chave          String   @unique
  unitId         String
  ocorridoEm     DateTime
  operacaoCod    String
  descricao      String?
  usuario        String?
  legacyMemberId Int?
  personId       String?

  @@index([unitId, ocorridoEm])
}

model ImportRun {
  id          String        @id @default(cuid())
  iniciadoEm  DateTime      @default(now())
  terminadoEm DateTime?
  /// dry-run | apply
  modo        String
  origem      String
  contagens   Json?
  ok          Boolean       @default(false)
  issues      ImportIssue[]
}

model ImportIssue {
  id      String    @id @default(cuid())
  run     ImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId   String
  arquivo String
  linha   Int?
  chave   String?
  motivo  String
  detalhe String?

  @@index([runId, motivo])
}

/// Audiência e pipeline do CloudGym (2019→2026). Histórico para o Analytics:
/// não entra na Captação, que é o funil vivo.
model LeadLegado {
  id           String    @id @default(cuid())
  /// audiencia:<lead_id> | pipeline:<lead_id>
  chave        String    @unique
  unitId       String
  nome         String
  tipo         String?
  cadastradoEm DateTime?
  celular      String?
  email        String?
  status       String?
  origem       String?
  vendedor     String?
  personId     String?

  @@index([unitId, cadastradoEm])
}
