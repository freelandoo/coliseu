# ============================================================
#  Coliseu Agent - configuracao (.env)
#  Preencha ANTES da visita; IDFACE_HOST se descobre na academia.
# ============================================================

# Driver do dispositivo: controlid (producao) | fake (teste sem hardware)
ADAPTER=controlid

# URL do CRM na nuvem (sem barra no final). Ex.: https://crm.suaacademia.com.br
BACKEND_URL=

# Token do agente - o MESMO valor configurado como AGENT_TOKEN na nuvem.
# Gere um valor longo e aleatorio (ex.: 64 caracteres hex).
AGENT_TOKEN=

# Id do AccessDevice (copie do dashboard /acesso do CRM)
DEVICE_ID=

# --- Catraca Control iD iDFace (rede local da academia) ---
# IP do aparelho: no iDFace, Menu > Rede. Ex.: 192.168.0.50
IDFACE_HOST=
IDFACE_USER=admin
IDFACE_PASS=

# --- Opcionais (defaults ok para 1 catraca) ---
# IDFACE_RULE_ID=1
# --- Botao "Liberar catraca" do CRM ---
# Padrao: autorizacao - o mesmo comando do CloudGym: uma entrada autorizada
# com o rele da catraca (SecBox) embutido. A tela mostra "Acesso liberado".
# Alternativas (outras catracas): auto (tenta catra -> sec_box -> door),
# catra, sec_box ou door. Deixe comentado para usar o padrao.
# IDFACE_OPEN_ACTION=autorizacao
# SecBox ligado a catraca (veja doors_state no aparelho; aqui e o 65793):
# IDFACE_SECBOX_ID=65793
# Sentido liberado na acao catra: both | clockwise | anticlockwise
# IDFACE_CATRA_ALLOW=both
# Saida usada so pela acao door (rele de porta):
# IDFACE_DOOR_ID=1
# INTERVALO_MS=5000
